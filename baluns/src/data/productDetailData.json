      "ct": {
        "hero": {
          "title": "CT Area Scan Camera",
          "description": "Engineered for industrial applications with premium performance. BASE/PRO/MAX configurations address varied needs. PRO/MAX models feature IP67 protection, multi-spectral fusion, and precision thermal control for harsh environments. MAX adds expanded interfaces for integrated lens/lighting/housing control, enhancing system flexibility.",
